# Application Configuration
APP_NAME=ScholarHub API
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:8081","http://localhost:19006","http://localhost:3000","http://127.0.0.1:8081","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://scholarhub_user:your_password@localhost:5432/scholarhub_db
DB_ECHO=false
